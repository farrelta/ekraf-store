DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mipa_store?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGIN=http://localhost:5173
API_INTERNAL_ORIGIN=http://localhost:3000
ALLOWED_DEV_ORIGINS=example-name.trycloudflare.com
API_PORT=3000
NODE_ENV=development
# Configure organization QRIS/bank details in Admin > Payments.
# Optional absolute directory for private payment receipts; defaults to api/storage/receipts.
# RECEIPT_STORAGE_DIR=
# Optional one-time admin bootstrap. Disabled unless explicitly enabled.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_TOKEN=

# Server-only hidden admin URL segment (16-100 letters/digits/hyphens/underscores).
ADMIN_PANEL_PATH=replace-with-a-random-private-admin-path

# Public customer support number with country code, digits only (no plus).
NEXT_PUBLIC_SUPPORT_WHATSAPP=6281287845351
# Staff-confirmed maximum payment review time in hours.
NEXT_PUBLIC_PAYMENT_REVIEW_HOURS=24

# Public product and QRIS uploads; keep separate from private receipts.
MEDIA_STORAGE_DIR=storage/media

# Optional R2 Standard storage. Leave all six blank to use local storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_RECEIPTS_BUCKET=
R2_MEDIA_ORIGIN=
