# Reference only: npm run e2e:prepare generates .env.e2e automatically.
# Do not copy a real .env.e2e into version control.
# Preparation reads your local .env database connection, creates the dedicated
# test database, and generates fresh credentials and an absolute receipt path.

DATABASE_URL=postgresql://postgres:replace-with-local-db-password@127.0.0.1:5432/ekraf_manual_e2e_test?schema=public
SESSION_SECRET=replace-with-a-generated-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=ekraf.e2e.sid
API_HOST=127.0.0.1
API_PORT=3919
FRONTEND_ORIGIN=http://127.0.0.1:5187
API_INTERNAL_ORIGIN=http://127.0.0.1:3919
ADMIN_PANEL_PATH=ekraf-test-admin-panel
# Generated as an absolute path by e2e:prepare; adjust if configuring manually.
RECEIPT_STORAGE_DIR=C:/path/to/ekraf-store/api/storage/e2e/receipts
NEXT_DIST_DIR=.next-e2e
NEXT_PUBLIC_E2E_MODE=true
ALLOWED_DEV_ORIGINS=127.0.0.1
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_TOKEN=
NODE_ENV=development

# Local fixture accounts only. A random shared password is generated during setup.
E2E_ADMIN_EMAIL=admin@example.test
E2E_CUSTOMER_EMAIL=customer@example.test
E2E_PASSWORD=replace-with-a-generated-test-only-password
