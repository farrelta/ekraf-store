// Initial EKRAF BEM MIPA UGM store design for drawDB: nine application tables.
// Proposed design only; application schema and migrations are managed separately.
// All IDs are application-generated opaque text. All monetary amounts are IDR.
// Rules in Notes require SQL constraints/triggers or application validation.

Enum roles {
  CUSTOMER
  ADMIN
}
Enum product_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
Enum selling_types {
  CONTINUOUS
  BATCH
}
Enum batch_status {
  DRAFT
  OPEN
  CLOSED
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}
Enum payment_status {
  PENDING
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}
Enum pickup_status {
  PENDING
  PROCESSING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}
Enum payment_method_types {
  QRIS
  BANK_TRANSFER
}
Enum submission_status {
  SUBMITTED
  VERIFIED
  REJECTED
}
Enum inventory_movement_types {
  RESERVATION
  RELEASE
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
}

Enum payment_plans {
  FULL
  BATCH_DEPOSIT
}
Enum payment_phases {
  INITIAL
  BALANCE
}

Table users [headercolor: #175e7a] {
  id text [pk, not null]
  email text [not null, unique]
  name text [not null]
  password_hash text [not null]
  role roles [not null, default: 'CUSTOMER']
  created_at timestamp [not null, default: `now()`]
}

Table products [headercolor: #175e7a] {
  id text [pk, not null]
  category text
  name text [not null]
  description text
  image_key text
  selling_type selling_types [not null]
  status product_status [not null, default: 'DRAFT']
  featured boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  indexes {
    category
    (status, name)
  }
  Note: 'One primary image. Category is a free-text label. Price and inventory belong only to variants. Create at least one variant per product before publication. Archive rather than delete referenced products. Do not change selling type after orders or batches exist.'
}

Table product_variants [headercolor: #175e7a] {
  id text [pk, not null]
  product_id text [not null]
  sku text [not null, unique]
  size text [not null, default: 'STANDARD']
  color text [not null, default: 'STANDARD']
  type text [not null, default: 'STANDARD']
  price decimal(12,2) [not null]
  on_hand integer [not null, default: 0]
  reserved integer [not null, default: 0]
  active boolean [not null, default: true]
  indexes {
    (product_id, size, color, type) [unique]
  }
  Note: 'One SKU per size/color combination. Normalize option spelling/case before enforcing uniqueness. STANDARD represents an option that is not offered; batch jackets require a preset size. Available = on_hand - reserved. Enforce price >= 0 and 0 <= reserved <= on_hand. Reserve continuous stock with a conditional availability update in the same transaction as the order and ledger entry. Disable rather than delete referenced variants.'
}

Table batches [headercolor: #175e7a] {
  id text [pk, not null]
  product_id text [not null]
  name text [not null]
  status batch_status [not null, default: 'DRAFT']
  opens_at timestamp [not null]
  closes_at timestamp [not null]
  production_weeks integer [not null, default: 4]
  announcement text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  indexes {
    (product_id, name) [unique]
    (status, closes_at)
  }
  Note: 'Only BATCH products can have batches. Enforce opens_at < closes_at and production_weeks > 0. Accept purchases only when status is OPEN and opens_at <= now < closes_at. Each batch belongs to one product and uses current catalog variant prices at checkout; order items preserve charged prices. Retain closed batches so the same product can have future batches.'
}

Table orders [headercolor: #175e7a] {
  id text [pk, not null]
  user_id text [not null]
  payment_plan payment_plans [not null, default: 'FULL']
  initial_amount decimal(12,2) [not null]
  idempotency_key text [not null, unique]
  customer_name text [not null]
  customer_phone text [not null]
  payment_status payment_status [not null, default: 'PENDING']
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  indexes {
    (user_id, created_at)
    (payment_status, expires_at)
  }
  Note: 'One mixed order may contain merchandise and multiple batches. Total is SUM(quantity * unit_price) in IDR. FULL requires full payment initially. BATCH_DEPOSIT requires full merchandise plus 50% of batch value, rounded to two decimals, snapshotted as initial_amount. Initial payment is due within 24 hours. Timely proof holds stock during review. Accepted deposits never auto-expire under the initial deadline; remaining balance must be verified before batch pickup. Contact fields and item prices are historical snapshots. Pickup is tracked per item.'
}

Table order_items [headercolor: #175e7a] {
  batch_id text
  pickup_status pickup_status [not null, default: 'PENDING']
  id text [pk, not null]
  order_id text [not null]
  variant_id text [not null]
  item_description text [not null]
  unit_price decimal(12,2) [not null]
  quantity integer [not null]
  embroidery_name text
  indexes {
    order_id
    variant_id
    (batch_id, pickup_status)
  }
  Note: 'batch_id is required for BATCH products and null for continuous products. Validate that batch and variant belong to the same product. Merchandise can be collected after its initial payment is verified, independently of batch items. Batch collection requires the order balance fully verified. Description snapshots product name, size/color and SKU; unit_price is the checkout price snapshot. Enforce quantity > 0 and unit_price >= 0. Product is obtained through variant_id. A nonblank embroidery_name is required for BATCH purchases and absent for CONTINUOUS purchases. Each line applies one embroidery name to all its units; use separate lines for different names. Do not impose unique(order_id, variant_id).'
}

Table payment_methods [headercolor: #175e7a] {
  id text [pk, not null]
  type payment_method_types [not null]
  name text [not null]
  instructions text
  qr_image_key text
  bank_name text
  account_name text
  account_number text
  enabled boolean [not null, default: true]
  Note: 'QRIS requires qr_image_key; bank transfer requires bank_name, account_name and account_number. Unused method-specific fields stay null. Customers select enabled methods only. Disable rather than delete methods referenced by submissions.'
}

Table payment_submissions [headercolor: #175e7a] {
  phase payment_phases [not null, default: 'INITIAL']
  id text [pk, not null]
  order_id text [not null]
  payment_method_id text [not null]
  method_snapshot jsonb [not null]
  amount decimal(12,2) [not null]
  transaction_reference text
  proof_key text [not null]
  status submission_status [not null, default: 'SUBMITTED']
  reviewed_by text
  review_reason text
  submitted_at timestamp [not null, default: `now()`]
  reviewed_at timestamp
  indexes {
    (order_id, submitted_at)
    (status, submitted_at)
  }
  Note: 'proof_key identifies a private receipt, retrieved only by its owner or authorized staff. method_snapshot preserves method name, type, instructions and destination details at submission time. Enforce amount > 0; verify the actual full order total and merchant transaction before approval. Only ADMIN can review. SUBMITTED requires null reviewer/reviewed_at; reviewed decisions require both; rejection requires a nonblank reason. Rejecting the initial payment permits resubmission before its 24-hour deadline; a paid deposit is preserved when balance evidence is rejected. Retain old attempts and freeze reviewed decisions. Allow at most one SUBMITTED per order and one VERIFIED per order/phase using partial unique indexes. INITIAL and BALANCE are verified independently. Prevent reuse of a verified merchant transaction reference per payment method using a partial unique index. Review and order payment transition are atomic; proof upload alone never marks an order paid.'
}

Table inventory_movements [headercolor: #175e7a] {
  order_item_id text
  id text [pk, not null]
  variant_id text
  variant_sku text [not null]
  order_id text
  batch_id text
  actor_id text
  type inventory_movement_types [not null]
  on_hand_delta integer [not null, default: 0]
  reserved_delta integer [not null, default: 0]
  reason text [not null]
  created_at timestamp [not null, default: `now()`]
  indexes {
    (variant_id, created_at)
    order_item_id
    order_id
    batch_id
  }
  Note: 'Append-only stock history: reject UPDATE/DELETE with SQL triggers. Update balances and insert movement atomically. Require at least one nonzero delta and ensure references match the variant product/order/batch. Reservation: (0,+q); release: (0,-q); reserved sale: (-q,-q); receipt or return: (+q,0). Batch checkout/payment does not reserve or consume ready stock before production receipt. Record batch receipts, then allocate received units to paid uncollected batch orders before exposing surplus to other purchases. On pickup consume the batch reservation. Continuous reservations are consumed at payment approval; do not decrement again at pickup. Restrict deletion of referenced records.'
}

Ref variant_product {
  product_variants.product_id > products.id [delete: restrict, update: cascade]
}
Ref batch_product {
  batches.product_id > products.id [delete: restrict, update: cascade]
}
Ref order_customer {
  orders.user_id > users.id [delete: restrict, update: cascade]
}
Ref item_batch {
  order_items.batch_id > batches.id [delete: restrict, update: cascade]
}
Ref item_order {
  order_items.order_id > orders.id [delete: restrict, update: cascade]
}
Ref item_variant {
  order_items.variant_id > product_variants.id [delete: restrict, update: cascade]
}
Ref submission_order {
  payment_submissions.order_id > orders.id [delete: restrict, update: cascade]
}
Ref submission_method {
  payment_submissions.payment_method_id > payment_methods.id [delete: restrict, update: cascade]
}
Ref submission_reviewer {
  payment_submissions.reviewed_by > users.id [delete: restrict, update: cascade]
}
Ref movement_variant {
  inventory_movements.variant_id > product_variants.id [delete: set null, update: cascade]
}
Ref movement_order {
  inventory_movements.order_id > orders.id [delete: restrict, update: cascade]
}
Ref movement_batch {
  inventory_movements.batch_id > batches.id [delete: restrict, update: cascade]
}
Ref movement_actor {
  inventory_movements.actor_id > users.id [delete: restrict, update: cascade]
}

Ref movement_item {
  inventory_movements.order_item_id > order_items.id [delete: restrict, update: cascade]
}
